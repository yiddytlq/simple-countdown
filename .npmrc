# NPM Performance Optimizations
# Created for Issue #50: Install npm dependencies

# Faster installs by preferring offline cache
prefer-offline=true

# Cleaner CI logs by disabling progress bar
progress=false

# Skip audit in CI (run separately for security)
audit=false

# Suppress funding messages
fund=false

# Exact version pinning for reproducible builds
save-exact=true

# Cache directory for better performance
cache=.npm-cache

# Registry configuration
registry=https://registry.npmjs.org/
