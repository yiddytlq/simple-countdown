# Copy to .env and fill in your values — see README.md for what each variable does.
TIMER_BACKGROUND=https://wallpaperplay.com/walls/full/0/7/6/29912.jpg
TIMER_TARGET=2026-12-31T23:59:59Z
TIMER_TITLE=My next birthday

# Optional (see README.md)
TIMER_DONE_MESSAGE=
TIMER_DONE_COUNTUP=
TIMER_DONE_ANIMATION=
TIMER_DONE_HIDE_TIMER=
TIMER_DONE_RELOAD=
TIMER_DONE_REDIRECT_URL=
TIMER_DONE_DELAY_MS=

# How much request traffic the container logs. Startup, shutdown and failures
# are always logged regardless -- this only controls successful requests.
#   error (default)  only failed requests (non-2xx/3xx)
#   info             every request
#   debug            every request, plus the generated config
# Default is error because a successful GET here is almost always an uptime
# monitor, which writes ~4 MB/day at one probe every five seconds.
LOG_LEVEL=error
