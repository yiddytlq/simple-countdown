# Simple Countdown Environment Variables
# 
# This file documents the environment variables supported by simple-countdown.
# Copy this file to .env.local for local development.

# Background image URL for the countdown page
TIMER_BACKGROUND="https://placehold.co/1920x1080/212121/212121.png"

# Target date/time for the countdown (ISO 8601 format recommended)
TIMER_TARGET="2025-12-31T23:59:59"

# Title text displayed on the countdown page
TIMER_TITLE="My Countdown Event"

# Docker build environment (used internally)
ENVIRONMENT=PRODUCTION